# Base production domain for canonical URLs, sitemaps, and OpenGraph (Optional — defaults to https://kartik-portfolio.vercel.app)
NEXT_PUBLIC_SITE_URL=https://kartik-portfolio.vercel.app

# Recipient Email address for contact form submissions
CONTACT_RECEIVER_EMAIL=kartiksharmaa2066@gmail.com


# Resend API Key (Optional — for live production email dispatch via Resend)
# Obtain from https://resend.com
RESEND_API_KEY=

# Webhook URL (Optional — for live alerts via Discord, Slack, or automation platforms)
CONTACT_WEBHOOK_URL=

# GitHub Personal Access Token (Optional — expands GitHub API rate limit from 60 to 5,000 req/hr)
# Generate a read-only classic token at https://github.com/settings/tokens
GITHUB_TOKEN=

